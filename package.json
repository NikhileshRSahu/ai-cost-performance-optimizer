{
  "name": "ai-cost-performance-optimizer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./economics": "./dist/economics/index.js",
    "./usage": "./dist/usage/index.js",
    "./ingestion": "./dist/ingestion/index.js",
    "./coverage": "./dist/coverage/index.js",
    "./detectors": "./dist/detectors/index.js",
    "./benchmarks": "./dist/benchmarks/index.js",
    "./ranking": "./dist/ranking/index.js",
    "./workbench": "./dist/workbench/index.js",
    "./ledger": "./dist/ledger/index.js",
    "./implementation": "./dist/implementation/index.js",
    "./verification": "./dist/verification/index.js",
    "./product-events": "./dist/product-events/index.js",
    "./auth": "./dist/auth/index.js",
    "./persistence": "./dist/persistence/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests examples apps/web",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "demo": "tsc -p tsconfig.demo.json && node dist/demo/examples/economics-demo.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "vitest run tests/persistence --exclude tests/persistence/schema.test.ts",
    "web:dev": "npm run dev --workspace @optimizer/web",
    "web:build": "npm run build --workspace @optimizer/web",
    "web:test": "vitest run tests/web"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "workspaces": [
    "apps/web"
  ]
}
