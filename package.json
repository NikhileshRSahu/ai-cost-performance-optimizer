{
  "name": "ai-cost-performance-optimizer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./economics": "./dist/economics/index.js",
    "./usage": "./dist/usage/index.js",
    "./ingestion": "./dist/ingestion/index.js",
    "./coverage": "./dist/coverage/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests examples",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "demo": "tsc -p tsconfig.demo.json && node dist/demo/examples/economics-demo.js"
  },
  "dependencies": {
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
