GOOGLE_CLIENT_ID=504485830242-1mk5p7h8aho03phd48ma9kisath17rk4.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
AUTH_SECRET=replace-with-at-least-32-random-characters
# Existing deployments may reuse BETTER_AUTH_SECRET as the Auth.js session secret.

# Jev (TypeSafe AI) decision layer. Disabled by default so no charges occur accidentally.
JEV_ENABLED=false
JEV_API_KEY=replace-with-typesafe-jev-api-key
# Set this to the API endpoint shown in your TypeSafe console/docs.
JEV_API_URL=
JEV_MODEL=jev-latest
